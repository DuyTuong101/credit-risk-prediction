    "import os, sys, subprocess\n",
    " \n",
    "IN_COLAB = \"google.colab\" in sys.modules\n",
    "REPO_URL = \"https://github.com/DuyTuong101/credit-risk-prediction.git\",
    "if IN_COLAB:\n",
    "    if not os.path.isdir(\"credit-risk-prediction\"):\n",
    "        subprocess.run([\"git\", \"clone\", REPO_URL], check=True)\n",
    "    os.chdir(\"credit-risk-prediction/notebooks\")\n",
    "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"-r\", \"../requirements.txt\"], check=True)\n",
    "print(\"Colab:\", IN_COLAB, \"| cwd:\", os.getcwd())"
   ]
