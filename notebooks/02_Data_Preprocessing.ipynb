   "source": [
    "num_cols = ['person_age', 'person_income', 'person_emp_length',\n",
    "            'loan_amnt', 'loan_int_rate', 'loan_percent_income', 'cb_person_cred_hist_length']\n",
    "ordinal_cols = ['loan_grade']\n",
    "nominal_cols = ['person_home_ownership', 'loan_intent', 'cb_person_default_on_file']\n",
    " \n",
    "configs = {\n",
    "    \"baseline\":         dict(impute_strategy=\"median\", scaler_type=\"standard\"),\n",
    "    \"minmax_0_1\":       dict(impute_strategy=\"median\", scaler_type=\"minmax\", feature_range=(0, 1)),\n",
    "    \"minmax_m1_1\":      dict(impute_strategy=\"median\", scaler_type=\"minmax\", feature_range=(-1, 1)),\n",
    "    \"robust_logincome\": dict(impute_strategy=\"median\", scaler_type=\"robust\", log_cols=[\"person_income\"]),\n",
    "    \"knn_indicator\":    dict(impute_strategy=\"knn\", scaler_type=\"standard\", add_missing_indicator=True),\n",
    "    \"standard_pca90\":   dict(impute_strategy=\"median\", scaler_type=\"standard\", pca_variance=0.90),\n",
    "    \"standard_pca95\":   dict(impute_strategy=\"median\", scaler_type=\"standard\", pca_variance=0.95),\n",
    "    \"minmax_pca95\":     dict(impute_strategy=\"median\", scaler_type=\"minmax\", feature_range=(0, 1), pca_variance=0.95),\n",
    "}\n",
    " \n",
    "summary_rows = []\n",
    "for name, cfg in configs.items():\n",
    "    pipe = build_preprocessing_pipeline(num_cols, ordinal_cols, nominal_cols, **cfg)\n",
    "    X_tr = pipe.fit_transform(X_train)           # fit CHỈ trên train\n",
    "    X_te = pipe.transform(X_test)                # test chỉ transform\n",
    " \n",
    "    assert not np.isnan(X_tr).any() and not np.isnan(X_te).any()\n",
    "    assert X_tr.shape[1] == X_te.shape[1] == len(get_feature_names(pipe))\n",
    " \n",
    "    save_features(name, pipe, X_tr, X_te, y_train, y_test, cfg,\n",
    "                  out_dir=FEATURES_DIR, save_pipeline=(name == \"baseline\"))\n",
    " \n",
    "    summary_rows.append({\n",
    "        \"Config\": name,\n",
    "        \"Imputer\": cfg.get(\"impute_strategy\"),\n",
    "        \"Scaler\": cfg.get(\"scaler_type\"),\n",
    "        \"Log cols\": \",\".join(cfg.get(\"log_cols\", [])) or \"-\",\n",
    "        \"Missing indicator\": cfg.get(\"add_missing_indicator\", False),\n",
    "        \"PCA variance\": cfg.get(\"pca_variance\") or \"-\",\n",
    "        \"n_features\": X_tr.shape[1],\n",
    "    })\n",
    " \n",
    "print(\"Baseline features:\", get_feature_names(\n",
    "    build_preprocessing_pipeline(num_cols, ordinal_cols, nominal_cols).fit(X_train)))\n",
    "display(pd.DataFrame(summary_rows))"
   ]
