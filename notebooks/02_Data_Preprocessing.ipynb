   "source": [
    "import os\n",
    "import sys\n",
    "import urllib.request\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    " \n",
    "sys.path.append(os.path.abspath(\"..\"))\n",
    "from modules.data_processing import (\n",
    "    clean_raw_data, split_data, build_preprocessing_pipeline,\n",
    "    get_feature_names, save_features,\n",
    ")\n",
    " \n",
    "RAW_PATH = \"../data/raw/credit_risk_dataset.csv\"\n",
    "RAW_URL = \"https://<link-public-cua-dataset>/credit_risk_dataset.csv\"     \n",
    "FEATURES_DIR = \"../features\"\n",
    "PROCESSED_DIR = \"../data/processed\"\n",
    "for d in (os.path.dirname(RAW_PATH), FEATURES_DIR, PROCESSED_DIR):\n",
    "    os.makedirs(d, exist_ok=True)\n",
    " \n",
    "if not os.path.exists(RAW_PATH):                \n",
    "    urllib.request.urlretrieve(RAW_URL, RAW_PATH)\n",
    " \n",
    "df_raw = pd.read_csv(RAW_PATH)\n",
    "print(\"Initial shape:\", df_raw.shape)"
   ]
  },
