  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "bdd0b75a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "-> duplicate rows                                removed   165 | remaining  32416\n",
      "-> person_age > 100                              removed     5 | remaining  32411\n",
      "-> emp_length > 60 or > age - 14                 removed     2 | remaining  32409\n",
      "==> Total removed: 172 | final samples: 32409\n",
      "X_train: (25927, 11) | X_test: (6482, 11)\n",
      "Default rate Train: 0.2187 | Test: 0.2188\n"
     ]
    }
   ],
   "source": [
    "df_clean = clean_raw_data(df_raw)              \n",
    "df_clean.to_csv(f\"{PROCESSED_DIR}/credit_risk_cleaned.csv\", index=False)\n",
    " \n",
    "\n",
    "X_train, X_test, y_train, y_test = split_data(df_clean, target_col=\"loan_status\")\n",
    " \n",
    "print(f\"X_train: {X_train.shape} | X_test: {X_test.shape}\")\n",
    "print(f\"Default rate Train: {y_train.mean():.4f} | Test: {y_test.mean():.4f}\")\n"
   ]
  },
